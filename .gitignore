build/
build-*/
__pycache__/
*.pyc
# Matrix raw outputs: decision/rx logs are retained only for seed 101 of the
# two walkthrough scenarios; overload event ledgers only for seed 101. Every
# pruned file is regenerated byte-identically by `make matrix` and its sha256
# is in results/matrix/manifest.json.
results/matrix/runs/**/decisions.csv
results/matrix/runs/**/rx.csv
results/matrix/runs/**/runtime.txt
!results/matrix/runs/alarm_outage/seed101/*/decisions.csv
!results/matrix/runs/alarm_outage/seed101/*/rx.csv
!results/matrix/runs/tight_deadline/seed101/*/decisions.csv
!results/matrix/runs/tight_deadline/seed101/*/rx.csv
results/matrix/runs/overload/seed10[2-5]/*/events.csv
